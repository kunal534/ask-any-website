# Copy to .env and fill in values. Never commit .env.
# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=chatbot

# Mistral AI (embeddings + chat)
MISTRAL_API_KEY=
# Chat model: ministral-8b-2512 (625K TPM / 3.1 RPS) is the default for
# quota headroom. Alternatives: ministral-3b-2512 (max RPS), mistral-small-latest.
MISTRAL_CHAT_MODEL=ministral-8b-2512
# Embedding model: keep 'mistral-embed' (1024 dims, matches index).
# Changing it requires clearing the Pinecone namespace.
MISTRAL_EMBED_MODEL=mistral-embed

# Upstash Redis (from https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
